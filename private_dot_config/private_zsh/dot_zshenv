[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# PATH
export PATH=$PATH:$HOME/bin
export PATH=$HOME/.local/bin:$PATH
export PATH=/home/linuxbrew/.linuxbrew/opt/postgresql@18/bin:$PATH

if [[ -d "$HOME/.rd/bin" ]]; then
    export PATH="$HOME/.rd/bin:$PATH"
fi

# Homebrew
if [[ "$(uname)" == "Linux" ]] && [[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ "$(uname)" == "Darwin" ]] && [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Deno - prefer native install (~/.deno) over brew
if [[ -d "$HOME/.deno/bin" ]]; then
    export DENO_INSTALL="$HOME/.deno"
    export PATH="$DENO_INSTALL/bin:$PATH"
fi

# Editor
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
    export VISUAL=nvim
elif command -v vim >/dev/null 2>&1; then
    export EDITOR=vim
    export VISUAL=vim
elif command -v nano >/dev/null 2>&1; then
    export EDITOR=nano
    export VISUAL=nano
fi

# Kubernetes
if [[ -f "$HOME/.kube/config" ]]; then
    export KUBECONFIG=$HOME/.kube/config
fi

# Worktrunk shell integration
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
