# Add deno completions to search path
if [[ ":$FPATH:" != *":$HOME/.config/zsh/completions:"* ]]; then export FPATH="$HOME/.config/zsh/completions:$FPATH"; fi
# Performance profiling (only if ZSH_PROFILE is set to true)
if [[ "${ZSH_PROFILE:l}" == "true" ]]; then
    zmodload zsh/zprof
    zmodload zsh/datetime
    ZSH_START_TIME=$EPOCHREALTIME
fi

# Start chezmoi git fetch early in background (only if needed)
_chezmoi_cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi_last_check"
_chezmoi_current_time=$(date +%s)
_chezmoi_should_check=false

# Check if we should fetch (once per hour = 3600 seconds)
_chezmoi_last_check=$(cat "$_chezmoi_cache_file" 2>/dev/null)
if [[ ! -f "$_chezmoi_cache_file" ]] || [[ -z "$_chezmoi_last_check" ]] || (( _chezmoi_current_time - _chezmoi_last_check > 3600 )); then
    _chezmoi_should_check=true
    # Start git fetch in background early. Use a regular background job (not &!)
    # so we can wait on it later and capture its exit status; capture stderr to
    # a temp file so a fetch failure can be surfaced instead of silently
    # reporting "dotfiles up to date".
    if command -v chezmoi &>/dev/null; then
        _chezmoi_fetch_log=$(mktemp -t chezmoi_fetch.XXXXXX 2>/dev/null)
        # Disable MONITOR so the shell doesn't print "[N] + done ..." when the
        # background fetch finishes; restored after the wait below.
        unsetopt MONITOR
        (git -C "$(chezmoi source-path)" fetch origin --quiet 2>"$_chezmoi_fetch_log" \
            && echo $_chezmoi_current_time > "$_chezmoi_cache_file") &
        _chezmoi_fetch_pid=$!
    fi
fi

# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Add in zsh plugins
zinit ice wait lucid
zinit light zsh-users/zsh-completions
zinit ice wait lucid
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting

# Add in snippets
# zinit snippet OMZP::kubectl
zinit ice wait lucid
zinit snippet OMZP::kubectx
zinit ice wait lucid
zinit snippet OMZP::git

# Load Completions
autoload -Uz compinit && compinit -C

# kubectl / velero / chezmoi / docker / deno / fnm completions are static files
# in ~/.config/zsh/completions (on $FPATH), regenerated by `refresh-completions`.
# They load via compinit above — no runtime `source <(...)` needed.

zinit cdreplay -q

# History
HISTFILE=~/.histfile
HISTSIZE=100000
SAVEHIST=100000
HISTDUP=erase
setopt sharehistory
setopt hist_reduce_blanks
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_find_no_dups

setopt autocd beep

bindkey -v
export KEYTIMEOUT=1  # Reduce ESC delay

# Change cursor shape for different vi modes
function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]] || [[ $1 = 'block' ]]; then
    echo -ne '\e[1 q'  # Block cursor
  elif [[ ${KEYMAP} == main ]] || [[ ${KEYMAP} == viins ]] || [[ $1 = 'beam' ]]; then
    echo -ne '\e[5 q'  # Beam cursor
  fi
}
zle -N zle-keymap-select

# Start with beam cursor
echo -ne '\e[5 q'
preexec() { echo -ne '\e[5 q' ;}

# Better vi mode bindings
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

# Enable fzf history search
# export FZF_DEFAULT_COMMAND='rg --files'  # (Requires `ripgrep` for faster file search)
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git/*"'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS='
  --height 40%
  --layout=reverse
  --border
  --preview "bat --style=numbers --color=always --line-range :500 {}"
  --preview-window=right:50%:wrap
  --bind "ctrl-/:toggle-preview"
  --color=fg:#c0caf5,bg:#1a1b26,hl:#bb9af7
'
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:hidden:wrap --bind '?:toggle-preview'"

# Key bindings for fzf
if command -v fzf &>/dev/null; then
    source <(fzf --zsh)
fi

# Starship prompt setup (defensive check)
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
else
    echo "⚠️  starship not found. Please run 'chezmoi apply' to install packages."
fi

# Neovim alias (editor vars exported in .zshenv)
if command -v nvim >/dev/null 2>&1; then
    alias vi=nvim
else
    echo "⚠️  neovim not found. Please run 'chezmoi apply' to install packages."
fi

# Aliases
alias v=nvim
alias k=kubectl
compdef _kubectl k
alias ll='eza -la'
alias brewup='brew update && brew upgrade && refresh-completions'

# keybinds
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word

# Set tab title
function set_local_title() {
  echo -ne "\033]0;$USER@$HOST\a"
}

# SSH wrapper to reset title after disconnect
ssh() {
  command ssh "$@"
  set_local_title
}

set_local_title

# Add any machine specific config
ZSH_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
if [[ -f "${ZSH_CONFIG_HOME}/zshrc.local" ]]; then
    source "${ZSH_CONFIG_HOME}/zshrc.local"
fi

# Enable path and shell command completion for GCP SDK
if command -v gcloud >/dev/null; then
  # Derive the SDK root from wherever gcloud actually lives (apt: /usr/lib,
  # tarball: $HOME, brew: /opt) instead of hardcoding a path.
  GCLOUD_PATH="$(dirname "$(dirname "$(readlink -f "$(command -v gcloud)")")")"
  [ -f "$GCLOUD_PATH/path.zsh.inc" ] && . "$GCLOUD_PATH/path.zsh.inc"
  if [ -f "$GCLOUD_PATH/completion.zsh.inc" ]; then
    # Tarball/macOS SDK ships a native zsh include.
    . "$GCLOUD_PATH/completion.zsh.inc"
  elif [ -f "$GCLOUD_PATH/completion.bash.inc" ]; then
    # Debian/RPM package ships only bash argcomplete; load it via bashcompinit.
    autoload -U +X bashcompinit && bashcompinit
    . "$GCLOUD_PATH/completion.bash.inc"
  fi
fi

# fnm for Node version manager
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell zsh)"
fi

# MySQL client (macOS Homebrew)
if [[ -d "/opt/homebrew/opt/mysql-client" ]]; then
    export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
    export LDFLAGS="-L/opt/homebrew/opt/mysql-client/lib"
    export CPPFLAGS="-I/opt/homebrew/opt/mysql-client/include"
    export PKG_CONFIG_PATH="/opt/homebrew/opt/mysql-client/lib/pkgconfig"
fi

# Zoxide (smarter cd)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# Run fastfetch if installed and in an interactive shell
if [[ -o interactive && -o login && -z "$FASTFETCH_SHOWN" && -z "$VSCODE_PID" ]] && command -v fastfetch >/dev/null 2>&1; then
  export FASTFETCH_SHOWN=1
  fastfetch
fi


# Display if any dotfiles have changed in remote git (optimized)
if [[ "$_chezmoi_should_check" == "true" ]] && command -v chezmoi &>/dev/null; then
    # Wait for background fetch and capture its exit status
    _chezmoi_fetch_status=0
    if [[ -n "$_chezmoi_fetch_pid" ]]; then
        wait $_chezmoi_fetch_pid
        _chezmoi_fetch_status=$?
    fi

    if (( _chezmoi_fetch_status != 0 )); then
        echo "chezmoi: failed to fetch updates"
        if [[ -n "$_chezmoi_fetch_log" && -s "$_chezmoi_fetch_log" ]]; then
            sed 's/^/  /' "$_chezmoi_fetch_log"
        fi
    else
        changed_files=$(chezmoi git -- diff --name-only origin/main 2>/dev/null)
        if [ -z "$changed_files" ]; then
            echo "chezmoi: dotfiles up to date"
        else
            formatted_files=()
            while IFS=$'\t' read -r additions deletions file; do
                file_summary=$(chezmoi git -- log --format=%s --no-merges -1 HEAD..origin/main -- "$file" 2>/dev/null)
                [[ -z "$file_summary" ]] && file_summary="uncommitted local changes"

                if [[ "$additions" == "-" || "$deletions" == "-" ]]; then
                    stat_text="binary"
                elif (( deletions == 0 )); then
                    stat_text="+${additions}"
                elif (( additions == 0 )); then
                    stat_text="-${deletions}"
                else
                    stat_text="+${additions} -${deletions}"
                fi
                formatted_files+=("${file} (${stat_text}): ${file_summary}")
            done < <(chezmoi git -- diff --numstat origin/main 2>/dev/null)

            if (( ${#formatted_files[@]} == 0 )); then
                for file in "${(@f)changed_files}"; do
                    file_summary=$(chezmoi git -- log --format=%s --no-merges -1 HEAD..origin/main -- "$file" 2>/dev/null)
                    [[ -z "$file_summary" ]] && file_summary="uncommitted local changes"
                    formatted_files+=("${file}: ${file_summary}")
                done
            fi

            print -r -- "chezmoi:"
            printf '  %s\n' "${formatted_files[@]}"
        fi
    fi

    [[ -n "$_chezmoi_fetch_log" ]] && rm -f "$_chezmoi_fetch_log"
    setopt MONITOR
elif command -v chezmoi &>/dev/null; then
    echo "chezmoi: checked recently (skipping)"
fi

# Clean up variables
unset _chezmoi_cache_file _chezmoi_current_time _chezmoi_should_check \
      _chezmoi_fetch_pid _chezmoi_fetch_log _chezmoi_fetch_status \
      changed_files formatted_files additions deletions file file_summary stat_text

# GPG TTY for signing commits
export GPG_TTY=$(tty)

# Display profiling results if ZSH_PROFILE is enabled
if [[ "${ZSH_PROFILE:l}" == "true" ]]; then
    local end=$EPOCHREALTIME
    zprof
    local elapsed=$(printf "%.3f" $(( end - ZSH_START_TIME )))
    echo "⏱️ Zsh startup time: ${elapsed}s"
fi
