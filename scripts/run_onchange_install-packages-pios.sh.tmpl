{{- if eq .chezmoi.arch "arm64" -}}
{{- if eq .chezmoi.os "linux" -}}
{{- if or (eq .chezmoi.osRelease.id "raspbian") (eq .chezmoi.osRelease.id "debian") -}}
#!/bin/bash
# Install packages for Raspberry Pi OS
# This script runs whenever packages_pios.yaml changes

set -euo pipefail

# Package list file checksum (triggers re-run when packages change)
# package hash: {{ include "packages_pios.yaml" | sha256sum }}

echo "🥧 Installing packages for Raspberry Pi OS with install type '{{ .install.type }}'..."

PACKAGE_FILE="{{ .chezmoi.sourceDir }}/packages_pios.yaml"
BREW_PREFIX="/home/linuxbrew/.linuxbrew"

# Check if package file exists
if [[ ! -f "$PACKAGE_FILE" ]]; then
    echo "❌ Package file not found: $PACKAGE_FILE"
    exit 1
fi

echo "📋 Using package file: $PACKAGE_FILE"
echo "🎯 Install type: {{ .install.type }}"

# Install native packages first via apt
echo "🔧 Installing native packages via apt..."

# Update package lists
sudo apt-get update -qq

# Ensure fzf is installed for better shell experience
if ! command -v fzf &>/dev/null; then
    echo "📥 Installing fzf for better shell experience..."

    mkdir -p $HOME/.local/bin
    wget -qO- https://github.com/junegunn/fzf/releases/download/v0.65.1/fzf-0.65.1-linux_arm64.tar.gz | tar -xz -C $HOME/.local/bin
fi

# Ensure yq is available for YAML parsing (install Go binary version)
if ! command -v yq &>/dev/null; then
    echo "📥 Installing yq for YAML parsing..."

    sudo wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_arm64 -O /usr/local/bin/yq
    sudo chmod +x /usr/local/bin/yq
fi

# Parse YAML and install packages
NATIVE_PACKAGES=$(yq eval '.native.lite[]' "$PACKAGE_FILE" 2>/dev/null || echo "")
{{- if or (eq .install.type "full") (eq .install.type "gui") }}
NATIVE_PACKAGES="$NATIVE_PACKAGES $(yq eval '.native.full[]' "$PACKAGE_FILE" 2>/dev/null || echo "")"
{{- end }}
{{- if eq .install.type "gui" }}
NATIVE_PACKAGES="$NATIVE_PACKAGES $(yq eval '.native.gui[]' "$PACKAGE_FILE" 2>/dev/null || echo "")"
{{- end }}

if [[ -n "$NATIVE_PACKAGES" ]]; then
    echo "Installing native packages: $NATIVE_PACKAGES"
    sudo apt-get install -y -qq $NATIVE_PACKAGES
fi

echo "✅ Native packages installed"

# Ensure Homebrew is installed and available
if ! command -v brew &>/dev/null; then
    echo "📥 Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Update Homebrew
echo "🔄 Updating Homebrew..."
brew update

# Install Homebrew taps
echo "🍺 Adding Homebrew taps..."
TAPS=$(yq eval '.homebrew.taps[]' "$PACKAGE_FILE" 2>/dev/null || echo "")
for tap in $TAPS; do
    if [[ -n "$tap" ]]; then
        brew tap "$tap" 2>/dev/null || echo "⚠️  Tap $tap already exists or failed to add"
    fi
done

# Install Homebrew packages
echo "🍺 Installing Homebrew packages..."

# Get packages based on install type
BREW_PACKAGES=$(yq eval '.homebrew.lite[]' "$PACKAGE_FILE" 2>/dev/null || echo "")
{{- if or (eq .install.type "full") (eq .install.type "gui") }}
BREW_PACKAGES="$BREW_PACKAGES $(yq eval '.homebrew.full[]' "$PACKAGE_FILE" 2>/dev/null || echo "")"
{{- end }}
{{- if eq .install.type "gui" }}
BREW_PACKAGES="$BREW_PACKAGES $(yq eval '.homebrew.gui[]' "$PACKAGE_FILE" 2>/dev/null || echo "")"
{{- end }}

if [[ -n "$BREW_PACKAGES" ]]; then
    echo "Installing Homebrew packages: $BREW_PACKAGES"
    for package in $BREW_PACKAGES; do
        if [[ -n "$package" ]]; then
            if ! brew list "$package" &>/dev/null; then
                echo "📦 Installing $package..."
                brew install "$package" || echo "⚠️  Failed to install $package"
            else
                echo "✅ $package already installed"
            fi
        fi
    done
fi

# Install custom packages
echo "🔧 Installing custom packages..."

# Get custom packages based on install type
CUSTOM_PACKAGES=$(yq eval '.custom.lite[]' "$PACKAGE_FILE" 2>/dev/null || echo "")
{{- if or (eq .install.type "full") (eq .install.type "gui") }}
CUSTOM_PACKAGES="$CUSTOM_PACKAGES $(yq eval '.custom.full[]' "$PACKAGE_FILE" 2>/dev/null || echo "")"
{{- end }}
{{- if eq .install.type "gui" }}
CUSTOM_PACKAGES="$CUSTOM_PACKAGES $(yq eval '.custom.gui[]' "$PACKAGE_FILE" 2>/dev/null || echo "")"
{{- end }}

if [[ -n "$CUSTOM_PACKAGES" ]]; then
    echo "Installing custom packages: $CUSTOM_PACKAGES"
    for package in $CUSTOM_PACKAGES; do
        if [[ -n "$package" ]]; then
            CUSTOM_SCRIPT="{{ .chezmoi.sourceDir }}/scripts/custom/${package}-pios.sh"
            if [[ -f "$CUSTOM_SCRIPT" ]]; then
                echo "🔧 Running custom installation for $package..."
                "$CUSTOM_SCRIPT" || echo "⚠️  Failed to install custom package $package"
            else
                echo "⚠️  Custom installation script not found: $CUSTOM_SCRIPT"
            fi
        fi
    done
fi

echo "✅ Custom packages processed"

# Post-installation setup
echo "🔧 Running post-installation setup..."

# Setup zinit directory if zsh is installed
if command -v zsh &>/dev/null; then
    ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
    if [[ ! -d "$ZINIT_HOME" ]]; then
        echo "📥 Setting up zinit directory..."
        mkdir -p "$(dirname "$ZINIT_HOME")"
    fi
fi

# Regenerate static shell completions for any newly installed tools
if [[ -x "$HOME/.local/bin/refresh-completions" ]]; then
    echo "🔧 Refreshing shell completions..."
    "$HOME/.local/bin/refresh-completions" || echo "⚠️  Completion refresh failed"
fi

echo "✅ Raspberry Pi OS package installation complete!"
echo "🎉 Raspberry Pi OS setup with '{{ .install.type }}' install type finished successfully!"
{{- end }}
{{- end }}
{{- end }}